<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ll</groupId>
    <artifactId>hirehub</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>hirehub</name>
    <description>招聘 / 求职平台微服务</description>

    <modules>
        <module>hirehub-common</module>
        <module>hirehub-api</module>
        <module>hirehub-gateway</module>
        <module>hirehub-auth</module>
        <module>hirehub-company</module>
        <module>hirehub-job</module>
        <module>hirehub-resume</module>
        <module>hirehub-delivery</module>
        <module>hirehub-interview</module>
        <module>hirehub-notification</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!--
          ★ 用 -release 而不是 -source/-target：
          本机 JAVA_HOME=E:\\jdk21，只写 -source/-target 17 时 javac 仍能看到 JDK 18~21 的 API，
          代码里误用（如 List.getFirst()、StringBuilder.repeat）编译期能过、跑到 JDK 17 上就炸，
          Maven 还会一直警告「未与 -source 17 一起设置系统模块路径」。
          maven-compiler-plugin 识别 maven.compiler.release，会传 -release 17，把 API 签名锁死在 17。
        -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 求新路线（D-03）：官方版本矩阵 Spring Boot 3.5.0 ↔ Spring Cloud 2025.0.0 ↔ SCA 2025.0.0.0 -->
        <spring-boot.version>3.5.0</spring-boot.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>

        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- 2.8.17：2.9.x 在 Boot3.5 下 Swagger UI 资源映射崩溃（/swagger-ui/**/*index.html），回退到修好该问题的 2.8.x 末版 -->
        <springdoc.version>2.8.17</springdoc.version>
        <micrometer-tracing.version>1.5.0</micrometer-tracing.version>
        <!-- 与 Spring Boot 3.5.0 管理的版本保持一致；显式声明是为了在注解处理器路径里引用 -->
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- MyBatis-Plus BOM（3.5.9+ 分页插件拆分为可选依赖） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- springdoc-openapi BOM（Boot 3 必须用 2.x，3.x 面向 Boot 4） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Micrometer Tracing BOM：spring-boot-dependencies 不直接管理 bridge-brave，需显式导入（§8.4） -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-tracing-bom</artifactId>
                <version>${micrometer-tracing.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.ll</groupId>
                <artifactId>hirehub-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ll</groupId>
                <artifactId>hirehub-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Maven Central 直连回退：settings.xml 里 aliyun 镜像只 mirrorOf=central，
      这里用不同的 id（central-direct）就不会被镜像接管。
      阿里云 public 镜像缺 io.micrometer.tracing 等少数坐标，用它兜底。
    -->
    <repositories>
        <repository>
            <id>central-direct</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <!-- 全局依赖：所有模块继承；Lombok optional 不传递，但每个模块自身可用 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- @Valid / @NotBlank 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          单元测试：JUnit 5 + AssertJ + Mockito（版本由 spring-boot-dependencies BOM 管理）。
          test scope 不传递给依赖方，所以放进根 pom 是安全的。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <!--
                      未继承 spring-boot-starter-parent 时，repackage 不会自动绑定到 package 阶段，
                      必须显式声明，否则 mvn package 出的是普通 jar，java -jar 报「没有主清单属性」。
                    -->
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              ★ 必须显式开启 -parameters：
              Spring Framework 6.1 起移除了 LocalVariableTableParameterNameDiscoverer，
              @PathVariable / @RequestParam 未显式写名字时只能靠编译期保留的参数名（-parameters）解析；
              缺了它，所有 /api/xxx/{id} 与 /internal 接口会在运行时抛
              "Name for argument of type [...] not specified"，被 GlobalExceptionHandler 兜底成 10002。
              本项目未继承 spring-boot-starter-parent，所以该开关不会自动生效，必须手写。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <parameters>true</parameters>
                    <!--
                      Lombok + 增量编译有坑：Maven 只把「变更过的源文件」交给 javac，
                      被 javac 隐式编译的其它源文件不会经过注解处理器，于是 @Data/@Slf4j
                      生成的方法全部「找不到符号」。关掉增量编译，保证整模块全量处理。
                    -->
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <!-- 显式声明注解处理器，避免依赖「classpath 上碰巧有 Lombok」的隐式行为 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
              ★ 必须显式指定 surefire 3.x：
              本项目未继承 spring-boot-starter-parent，插件版本不会自动被管理；
              而 Maven 默认绑定的 surefire 2.x 不认识 JUnit 5（junit-platform），
              结果是 **一个用例都不执行**却报 BUILD SUCCESS ——
              输出里是「Tests run: 0」，看起来"全绿"，其实测试根本没跑。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
            </plugin>
        </plugins>
    </build>
</project>
