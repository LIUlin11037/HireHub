<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ll</groupId>
        <artifactId>hirehub</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>hirehub-gateway</artifactId>
    <name>hirehub-gateway</name>
    <description>网关：路由 + 统一鉴权</description>

    <dependencies>
        <dependency>
            <groupId>com.ll</groupId>
            <artifactId>hirehub-common</artifactId>
        </dependency>
        <!-- ⚠️ Spring Cloud 2025：Gateway 坐标已改名，旧 spring-cloud-starter-gateway 已废弃（架构文档 §2.2） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- lb:// 服务名路由需要 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 二期：Micrometer Tracing（traceId 全链路，见 §8.4） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <!-- 三期修正：tracing 的自动配置（BraveAutoConfiguration）位于
             spring-boot-actuator-autoconfigure，只引 bridge 不会创建 Tracer bean，
             traceId 全链路实际是断的（见踩坑记录 #19）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 二期：Sentinel 限流降级（见 §8.3） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- 二期：Sentinel 规则持久化到 Nacos（见 §8.3） -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
            <version>1.8.9</version>
        </dependency>
        <!-- 二期：Spring Cloud Gateway 路由级限流适配器。
             SCA 的 sentinel starter 不含它（依赖树里只有 webflux-adapter），
             缺了它路由限流根本不生效——实测 30 次/11QPS 全部放行后补上。 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-spring-cloud-gateway-adapter</artifactId>
            <version>1.8.9</version>
        </dependency>
        <!-- 三期：access token 黑名单校验（D-02）。必须是响应式客户端——
             网关是 WebFlux/Netty，用阻塞 Redis 会占死事件循环线程。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
